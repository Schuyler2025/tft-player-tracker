# Riot API Configuration
RIOT_API_KEY=RGAPI-49b974d7-42a8-4715-9225-2fd29d2382e7
RIOT_API_REGION=na1
RIOT_API_ROUTING=americas

# Rate Limiting (Development: 20 requests per second, 100 per 2 minutes)
RIOT_API_RATE_LIMIT_PER_SECOND=20
RIOT_API_RATE_LIMIT_PER_2MIN=100

# Polling Interval (seconds)
POLLING_INTERVAL=120

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Database Configuration
DATABASE_URL=sqlite:///./tft_tracker.db

# Discord Configuration
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CHANNEL_ID=your-channel-id

# WeChat Configuration (Optional)
WECHAT_APP_ID=your-app-id
WECHAT_APP_SECRET=your-app-secret
WECHAT_TEMPLATE_ID=your-template-id

# Notification Rules
LP_CHANGE_THRESHOLD=50
LP_DAILY_CHANGE_THRESHOLD=100
ENABLE_RANK_CHANGE_NOTIFICATION=true
ENABLE_LP_THRESHOLD_NOTIFICATION=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/tft_tracker.log
